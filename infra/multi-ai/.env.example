COMPOSE_PROJECT_NAME=helpus-multi-ai
LITELLM_IMAGE=ghcr.io/berriai/litellm-database:main-stable
LITELLM_BIND_ADDRESS=127.0.0.1
LITELLM_PORT=4000
LITELLM_MASTER_KEY=GENERATE_ME
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=GENERATE_ME
DATABASE_URL=postgresql://litellm:GENERATE_ME@postgres:5432/litellm
REDIS_URL=redis://redis:6379/0
HELPUS_ROUTER_BIND_ADDRESS=127.0.0.1
HELPUS_ROUTER_PORT=8080
HELPUS_ROUTER_API_KEY=GENERATE_ME
HELPUS_GATEWAY_BASE_URL=http://litellm:4000/v1
HELPUS_GATEWAY_API_KEY=GENERATE_ME
HELPUS_GATEWAY_TIMEOUT_SECONDS=180
HELPUS_DEFAULT_MODE=auto
HELPUS_COUNCIL_VERIFY=true
HELPUS_FAST_MODEL=openai/REPLACE_FAST_MODEL
HELPUS_FAST_API_BASE=https://REPLACE_FAST_ENDPOINT/v1
HELPUS_FAST_API_KEY=REPLACE_FAST_API_KEY
HELPUS_GENERAL_MODEL=openai/REPLACE_GENERAL_MODEL
HELPUS_GENERAL_API_BASE=https://REPLACE_GENERAL_ENDPOINT/v1
HELPUS_GENERAL_API_KEY=REPLACE_GENERAL_API_KEY
HELPUS_REASONER_MODEL=openai/REPLACE_REASONER_MODEL
HELPUS_REASONER_API_BASE=https://REPLACE_REASONER_ENDPOINT/v1
HELPUS_REASONER_API_KEY=REPLACE_REASONER_API_KEY
HELPUS_CODE_MODEL=openai/REPLACE_CODE_MODEL
HELPUS_CODE_API_BASE=https://REPLACE_CODE_ENDPOINT/v1
HELPUS_CODE_API_KEY=REPLACE_CODE_API_KEY
HELPUS_VISION_MODEL=openai/REPLACE_VISION_MODEL
HELPUS_VISION_API_BASE=https://REPLACE_VISION_ENDPOINT/v1
HELPUS_VISION_API_KEY=REPLACE_VISION_API_KEY
HELPUS_VERIFIER_MODEL=openai/REPLACE_VERIFIER_MODEL
HELPUS_VERIFIER_API_BASE=https://REPLACE_VERIFIER_ENDPOINT/v1
HELPUS_VERIFIER_API_KEY=REPLACE_VERIFIER_API_KEY
HELPUS_EMBEDDING_MODEL=openai/REPLACE_EMBEDDING_MODEL
HELPUS_EMBEDDING_API_BASE=https://REPLACE_EMBEDDING_ENDPOINT/v1
HELPUS_EMBEDDING_API_KEY=REPLACE_EMBEDDING_API_KEY
