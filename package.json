{
  "name": "helpus-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:frontend": "npm --prefix frontend install",
    "build": "npm --prefix frontend run build",
    "dev": "npm --prefix frontend run dev",
    "start": "npm --prefix frontend run start",
    "smoke:prod": "node scripts/29_smoke_prod.js",
    "smoke:providers": "python scripts/30_smoke_ai_providers.py",
    "smoke:chat": "node scripts/31_smoke_prod_chat.js",
    "test:fallback": "python scripts/32_test_fallback_order.py",
    "smoke:internal-chat": "node scripts/33_smoke_internal_chat_flow.js",
    "smoke:local-api": "python scripts/34_smoke_local_readonly_api.py",
    "smoke:admin-local": "python scripts/helpusai/smoke_admin_local_readonly_panel.py && python scripts/helpusai/smoke_admin_local_readonly_link.py",
    "smoke:phase-a": "npm run smoke:local-api && npm run smoke:admin-local && npm run build",
    "smoke:phase-b-plan": "python scripts/35_smoke_local_safe_plan.py && python scripts/36_smoke_local_plan_contract.py",
    "smoke:phase-b-ui": "python scripts/helpusai/smoke_admin_local_safe_plan_panel.py && python scripts/helpusai/smoke_admin_local_custom_plan_panel.py",
    "smoke:phase-b": "npm run smoke:phase-b-plan && npm run smoke:phase-b-ui && npm run smoke:admin-local && npm run build",
    "smoke:phase-c-audit": "python scripts/37_smoke_local_plan_audit.py",
    "smoke:phase-c": "npm run smoke:phase-c-audit && npm run smoke:phase-b"
  }
}
